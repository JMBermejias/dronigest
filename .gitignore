# Dronigest .gitignore

# Certificados SSL autofirmados
.cert/
*.pem
*.key
*.crt

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# Sistema
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporal
generar-iconos.py

# Paquetes .deb (se suben a las releases de GitHub, no al repo)
*.deb

# Proyecto bubblewrap (contiene el keystore, no subir)
bubblewrap-build/
